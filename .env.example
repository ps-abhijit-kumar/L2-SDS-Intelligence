# ==============================================================================
# L2 SDS Intelligence — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your local credentials before starting.
# NEVER commit your actual .env file or API keys to version control.
# ==============================================================================

# Groq Cloud API Key (Required for autonomous LLM validation agent)
# Obtain an API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Identifier (Default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Excel Database Benchmark File Path (Default: sample_requests_eval.xlsx)
EXCEL_FILE_PATH=sample_requests_eval.xlsx

# FastAPI Backend Server Configuration
HOST=127.0.0.1
PORT=8000
